# =============================================================================
# Demo ante fallo de Supabase: solo para presentaciones / fallback documentado.
# La app ya usa DEMO_BYPASS_AUTH para dashboard con org fija (requiere DB con datos).
# NEXT_PUBLIC_DEMO_MODE aquí es placeholder hasta implementar UI 100% offline.
# =============================================================================

SUPABASE_ENV=demo

NEXT_PUBLIC_DEMO_MODE=true
DEMO_BYPASS_AUTH=true

# Opcional: si querés que la app siga apuntando a un Supabase mínimo de solo lectura
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_URL=
