{
  "$schema_comment": "POST /api/vapi/events — body JSON (type requerido por VapiEventInputSchema). organization_id en body o query ?organization_id=",
  "demo_organization_id": "11111111-1111-1111-1111-111111111111",
  "curl_hint": "curl -s -X POST \"http://localhost:3000/api/vapi/events?organization_id=11111111-1111-1111-1111-111111111111\" -H \"Content-Type: application/json\" -d @payload.json",
  "examples": {
    "assistant-request": {
      "type": "assistant-request",
      "organization_id": "11111111-1111-1111-1111-111111111111",
      "call": {
        "id": "vapi-demo-call-001",
        "customerPhoneNumber": "+18135551001"
      }
    },
    "tool-calls_find_customer": {
      "type": "tool-calls",
      "organization_id": "11111111-1111-1111-1111-111111111111",
      "call": {
        "id": "vapi-demo-call-001",
        "customerPhoneNumber": "+18135551001"
      },
      "toolCallList": [
        {
          "toolCallId": "tc-find-customer-1",
          "function": {
            "name": "find_customer",
            "arguments": "{\"phone\":\"+18135551001\",\"name\":\"Juan\"}"
          }
        }
      ]
    },
    "tool-calls_get_job_status": {
      "type": "tool-calls",
      "organization_id": "11111111-1111-1111-1111-111111111111",
      "call": {
        "id": "vapi-demo-call-001",
        "customerPhoneNumber": "+18135551001"
      },
      "toolCallList": [
        {
          "toolCallId": "tc-job-status-1",
          "function": {
            "name": "get_job_status",
            "arguments": "{\"job_number\":\"WO-1001\"}"
          }
        }
      ]
    },
    "transfer-destination-request": {
      "type": "transfer-destination-request",
      "organization_id": "11111111-1111-1111-1111-111111111111",
      "call": {
        "id": "vapi-demo-call-001",
        "customerPhoneNumber": "+18135551001"
      }
    },
    "call-ended": {
      "type": "call-ended",
      "organization_id": "11111111-1111-1111-1111-111111111111",
      "call": {
        "id": "vapi-demo-call-001",
        "customerPhoneNumber": "+18135551001",
        "customerName": "Juan Perez"
      },
      "transcript": "Cliente: Quería el estado del trabajo WO-1001. Bot: Está en progreso.",
      "summary": "Consulta de estado WO-1001; trabajo en progreso.",
      "disposition": "resolved"
    }
  }
}
