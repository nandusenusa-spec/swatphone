# =============================================================================
# Copiar a .env.local y completar en local. En producción usar Vercel → Environment Variables.
# NO commitear .env ni .env.local. Valores vacíos = rellenar en el dashboard.
# =============================================================================

# --- App (público) ---
# Alta de empresas nuevas con rubro en /auth/registrar (no afecta clientes creados por Admin).
ENABLE_PUBLIC_ORG_REGISTRATION=true
NEXT_PUBLIC_ENABLE_PUBLIC_ORG_REGISTRATION=true

# TEMP DEMO ONLY — dashboard without Supabase Auth (fixed org). Never enable in production long-term.
DEMO_BYPASS_AUTH=

# UUID de la org Luma (línea de la plataforma). NO usar el UUID de SWATWORKS ni de otros clientes.
# Si vacío: Admin → Clientes muestra todos los tenants; Leads/Llamadas Luma quedan vacíos hasta configurar.
LUMA_PLATFORM_ORGANIZATION_ID=

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (servidor) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# --- Vapi (no subir claves reales al repo) ---
VAPI_API_KEY=
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Fallback sync-assistant / phone (no hardcodear UUIDs en código)
VAPI_PRODUCTION_ORG_ID=
VAPI_PRODUCTION_ASSISTANT_ID=
VAPI_PRODUCTION_PHONE_NUMBER_ID=
# assistantUuid:orgUuid,assistantUuid2:orgUuid2 (solo si falla lookup en organizations.vapi_assistant_id)
VAPI_ASSISTANT_ORG_MAPPING=
# En producción: obligatorio. Vapi debe enviar el mismo valor en header x-vapi-secret en POST a
# /api/vapi/events, /api/vapi/tools/* y /api/vapi/webhook (el middleware lo exige si está definido).
VAPI_WEBHOOK_SECRET=
VAPI_TRANSFER_HOLD_AUDIO_URL=
# Llamada: duración máxima (default 360 = 6 min), silencio sin hablar (default 25 s), latencia de respuesta
VAPI_MAX_CALL_DURATION_SECONDS=360
VAPI_SILENCE_TIMEOUT_SECONDS=25
VAPI_START_WAIT_SECONDS=0.25
VAPI_DEEPGRAM_ENDPOINTING_MS=250

# --- Telegram (notificaciones de leads / citas) ---
TELEGRAM_BOT_TOKEN=
# Chat global (SWATWORKS y clientes sin telegram_chat_ids en Admin). Por cliente: Admin → Cliente → Chat ID(s).
# Tu chat (obligatorio). Tras /start con el bot: GET /api/telegram/discover con x-admin-secret
TELEGRAM_CHAT_ID=
# Segunda persona u otros (chat_id numérico, separados por coma). No es el teléfono móvil.
TELEGRAM_EXTRA_CHAT_IDS=

# Transferencias: por defecto blind-transfer (fiable). true = warm-transfer-experimental (solo Twilio/Vapi number).
# VAPI_TRANSFER_WARM=false
# Opcional: lista completa reemplaza la unión de las dos anteriores
# TELEGRAM_CHAT_IDS=123456789,987654321

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- OpenAI (si el pipeline lo requiere) ---
OPENAI_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FORWARD_NUMBER=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_SETUP=
# true = exige suscripción activa/trial en /dashboard (migración 021 + webhook)
STRIPE_ENFORCE_BILLING=

# --- Auth genérico (si usás NextAuth u otro) ---
NEXTAUTH_SECRET=
JWT_SECRET=

# --- Base de datos directa (opcional; suele ser la URL de Supabase/Postgres) ---
DATABASE_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# --- API / admin de esta app ---
# POST /api/admin/run-plan-b-migration y GET /api/admin/supabase-health: header x-admin-secret
ADMIN_SECRET=
# Vercel Cron → GET /api/cron/daily-summary (Authorization: Bearer CRON_SECRET). Manual: x-admin-secret.
CRON_SECRET=
# Solo true temporalmente para ejecutar migración Plan B vía API; luego false o borrar.
ALLOW_ADMIN_MIGRATIONS=
ALLOW_SEED_ENDPOINTS=
ADMIN_TOKEN_SECRET=
# APIs internas (client-lookup, client-status, work-orders/status): si está definida, exige
# X-Internal-Key o Authorization: Bearer (comparación en tiempo constante).
INTERNAL_API_KEY=
# Opcional: en producción, si es "true", la respuesta de get-job-status incluye objeto `debug` (sin PII completo).
DEBUG_VAPI_TOOLS=
# Opcional: fallback de organization_id para POST /api/vapi/tools/get-job-status (Vapi sin args).
DEFAULT_GET_JOB_STATUS_ORGANIZATION_ID=
# VAPI_DEFAULT_ORGANIZATION_ID=
