# =============================================================================
# Copiar a .env.local y completar en local. En producción usar Vercel → Environment Variables.
# NO commitear .env ni .env.local. Valores vacíos = rellenar en el dashboard.
# =============================================================================

# --- App (público) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (servidor) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# --- Vapi (no subir claves reales al repo) ---
VAPI_API_KEY=
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# En producción: obligatorio. Vapi debe enviar el mismo valor en header x-vapi-secret en POST a
# /api/vapi/events, /api/vapi/tools/* y /api/vapi/webhook (el middleware lo exige si está definido).
VAPI_WEBHOOK_SECRET=
VAPI_TRANSFER_HOLD_AUDIO_URL=

# --- OpenAI (si el pipeline lo requiere) ---
OPENAI_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FORWARD_NUMBER=

# --- Auth genérico (si usás NextAuth u otro) ---
NEXTAUTH_SECRET=
JWT_SECRET=

# --- Base de datos directa (opcional; suele ser la URL de Supabase/Postgres) ---
DATABASE_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# --- API / admin de esta app ---
ADMIN_TOKEN_SECRET=
# APIs internas (client-lookup, client-status, work-orders/status): si está definida, exige
# X-Internal-Key o Authorization: Bearer (comparación en tiempo constante).
INTERNAL_API_KEY=
# Opcional: en producción, si es "true", la respuesta de get-job-status incluye objeto `debug` (sin PII completo).
DEBUG_VAPI_TOOLS=
# Opcional: fallback de organization_id para POST /api/vapi/tools/get-job-status (Vapi sin args).
DEFAULT_GET_JOB_STATUS_ORGANIZATION_ID=
# VAPI_DEFAULT_ORGANIZATION_ID=
